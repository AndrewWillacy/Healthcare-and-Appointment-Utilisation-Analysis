   "source": [
    "# Merge ar_clean with nc_clean\n",
    "regional = ar_clean  \n",
    "national = nc_clean \n",
    "\n",
    "# Ensure 'appointment_month' is datetime for consistent merging\n",
    "regional['appointment_month'] = pd.to_datetime(regional['appointment_month'])\n",
    "national['appointment_month'] = pd.to_datetime(national['appointment_month'])\n",
    "\n",
    "# Aggregate national appointments and rename the column\n",
    "national_agg = national.groupby(['appointment_month', 'icb_ons_code'], as_index=False)['count_of_appointments'].sum()\n",
    "national_agg.rename(columns={'count_of_appointments': 'national_appointments'}, inplace=True)\n",
    "\n",
    "# Perform inner join on both 'appointment_month' and 'icb_ons_code'\n",
    "merged = pd.merge(regional, national_agg, on=['appointment_month', 'icb_ons_code'], how='inner')\n",
    "\n",
    "# Display the first few rows of the merged DataFrame\n",
    "(merged.head())\n"
   ]
