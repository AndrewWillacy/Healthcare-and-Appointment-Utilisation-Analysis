    "# Estimate weekdy utilisation vs capacity\n",
    "# Ensure appointment_month is datetime (start of month)\n",
    "ar_am['appointment_month'] = pd.to_datetime(ar_am['appointment_month']).dt.to_period('M').dt.to_timestamp()\n",
    "\n",
    "# Calculate weekdays per month (Monday to Friday count)\n",
    "def count_weekdays_in_month(date):\n",
    "    # Get all days in the month\n",
    "    days = pd.date_range(start=date, end=date + pd.offsets.MonthEnd(0))\n",
    "    # Count weekdays (Mon-Fri)\n",
    "    return sum(day.weekday() < 5 for day in days)\n",
    "\n",
    "ar_am['weekday_count'] = ar_am['appointment_month'].apply(count_weekdays_in_month)\n",
    "\n",
    "# Daily capacity and calculation of utilisation\n",
    "daily_capacity = 1200000\n",
    "\n",
    "ar_am['utilisation'] = (ar_am['count_of_appointments'] / (ar_am['weekday_count'] * daily_capacity)) * 100\n",
    "ar_am['utilisation'] = ar_am['utilisation'].round(1)\n",
    "\n",
    "# Plot utilisation over time\n",
    "plt.figure(figsize=(16, 6))\n",
    "sns.lineplot(data=ar_am, x='appointment_month', y='utilisation', marker='o', color='orange', label='Utilisation (%)')\n",
    "\n",
    "# Highlight months with utilisation over 100%\n",
    "over = ar_am[ar_am['utilisation'] > 100]\n",
    "plt.scatter(over['appointment_month'], over['utilisation'], color='red', s=100, label='Over 100% Utilisation')\n",
    "\n",
    "# Capacity line at 100%\n",
    "plt.axhline(y=100, color='gray', linestyle='--', linewidth=2, label='100% Capacity')\n",
    "\n",
    "# Add lockdown shaded periods \n",
    "\n",
    "\n",
    "for start, end in [('2020-03-01', '2020-06-01'), ('2020-11-01', '2020-12-01'), ('2021-01-01', '2021-03-01')]:\n",
    "    plt.axvspan(pd.to_datetime(start), pd.to_datetime(end), color='grey', alpha=0.2)\n",
    "\n",
    "# Title, labels and legend box\n",
    "plt.title('Estimated Weekday Utilisation of Appointment Capacity', fontsize=18)\n",
    "plt.xlabel('Appointment Month', fontsize=14)\n",
    "plt.ylabel('Utilisation (%)', fontsize=14)\n",
    "plt.xticks(rotation=45)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
