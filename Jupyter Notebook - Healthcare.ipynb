   "source": [
    "import geopandas as gpd\n",
    "\n",
    "# Load GeoJSON \n",
    "geo_path = r'c:\\users\\tamar\\Downloads\\sub_icb_boundaries_geojson.geojson'\n",
    "geo_df = gpd.read_file(geo_path)[['SICBL22NM', 'geometry']].copy()\n",
    "\n",
    "# Expect dna_percentage_df to already exist \n",
    "required = {'sub_icb_location_name', 'dna_percentage'}\n",
    "missing = required - set(dna_percentage_df.columns)\n",
    "if missing:\n",
    "    raise ValueError(f\"dna_percentage_df missing columns: {missing}\")\n",
    "\n",
    "# Normalise names for a reliable merge\n",
    "def _norm(s: pd.Series) -> pd.Series:\n",
    "    return s.astype(str).str.strip().str.casefold()\n",
    "\n",
    "geo_df['key'] = _norm(geo_df['SICBL22NM'])\n",
    "dna = dna_percentage_df[['sub_icb_location_name', 'dna_percentage']].copy()\n",
    "dna['key'] = _norm(dna['sub_icb_location_name'])\n",
    "\n",
    "#Merge\n",
    "merged = geo_df.merge(dna[['key', 'dna_percentage']], on='key', how='left')\n",
    "\n",
    "# Plot choropleth\n",
    "ax = merged.plot(column='dna_percentage', cmap='Reds', legend=True, legend_kwds={'label': 'DNA Percentage (%)'}, edgecolor='black',\n",
    "    linewidth=0.4, missing_kwds={'color': 'lightgrey'})\n",
    "plt.title('DNA % by Sub-ICB Location (England)')\n",
    "plt.axis('off')\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
