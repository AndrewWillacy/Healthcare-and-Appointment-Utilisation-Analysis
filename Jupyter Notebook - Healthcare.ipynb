   "source": [
    "# Group by month and calculate total appointments\n",
    "ar_am = ar.groupby('appointment_month', as_index=False)['count_of_appointments'].sum()\n",
    "\n",
    "# Convert 'appointment_month' to datetime \n",
    "ar['appointment_month'] = pd.to_datetime(ar['appointment_month'])\n",
    "\n",
    "# Define the maximum daily capacity\n",
    "max_daily_capacity = 1200000\n",
    "\n",
    "# Calculate utilisation as a percentage (assuming 30 days in a month)\n",
    "# Using 30 days includes weekends, but weekends are well under capacity so this may skew the data\n",
    "ar_am['utilisation'] = (ar_am['count_of_appointments'] / (30 * max_daily_capacity)) * 100\n",
    "ar_am['utilisation'] = ar_am['utilisation'].round(1)\n",
    "\n",
    "# Sort by utilisation descending and reset index \n",
    "ar_am = ar_am.sort_values(by='utilisation', ascending=False).reset_index(drop=True)\n",
    "ar_am.index = ar_am.index + 1  # Start index from 1\n",
    "\n",
    "# View the final DataFrame\n",
    "ar_am\n"
   ]
  },
