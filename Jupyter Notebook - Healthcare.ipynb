    "### **Appointments by Mode**"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 82,
   "id": "bc53da68-2fd4-4bb1-b3a3-729851a1b776",
   "metadata": {},
   "outputs": [
    {
     "data": {
